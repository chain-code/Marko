{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["env.d.ts", "src/utils/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  }
}
