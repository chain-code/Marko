{
  "name": "@marko/desktop",
  "productName": "Marko",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Marko：本地优先的 Markdown 编辑器",
  "author": "chain-code",
  "license": "MIT",
  "homepage": "https://github.com/chain-code/Marko",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/check-main-bundle.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "pack": "npm run build && electron-builder --dir",
    "predist": "node scripts/installers.mjs clean",
    "dist": "npm run build && electron-builder --publish never",
    "postdist": "node scripts/installers.mjs collect"
  },
  "dependencies": {
    "@intlify/core-base": "^11.4.23",
    "@parcel/watcher": "^2.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "electron-context-menu": "^4.1.2",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "electron-window-state": "^5.0.3",
    "fzf": "^0.5.2",
    "iconv-lite": "^0.6.3",
    "jschardet": "^4.1.0",
    "postcss": "^8.5.33",
    "postcss-import": "^17.0.1",
    "postcss-url": "^10.1.4",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@marko/editor": "*",
    "@marko/editor-vue": "*",
    "@marko/markdown": "*",
    "@marko/render": "*",
    "@marko/shared": "*",
    "@marko/themes": "*",
    "@types/postcss-import": "^14.0.3",
    "@types/postcss-url": "^10.0.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.8",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.2",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.23"
  }
}
