{
  "name": "marko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown desktop editor powered by Vue and Tauri",
  "author": "chain-code",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:logic && npm run test:types && npm run test:components",
    "test:logic": "node scripts/run-unit-tests.mjs",
    "test:types": "vue-tsc --noEmit -p tsconfig.components.json",
    "test:components": "vitest run",
    "verify": "npm test && cargo test --manifest-path src-tauri/Cargo.toml && npm run build",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "pack:win": "npm run build && node scripts/run-tauri.mjs build --bundles nsis --target x86_64-pc-windows-msvc",
    "pack:mac-arm": "node scripts/run-tauri.mjs build --bundles app,dmg --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@tauri-apps/api": "^2.0.0",
    "codemirror": "^6.0.2",
    "flowchart.js": "^1.18.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "^20.10.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
