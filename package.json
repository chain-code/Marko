{
  "name": "marko",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "Local-first Markdown editor: the Electron desktop app and its Vue editor component",
  "author": "chain-code",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "types": "./dist-lib/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/library.d.ts",
      "import": "./dist-lib/marko-editor.js"
    },
    "./style.css": "./dist-lib/marko-editor.css"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "npm run dev -w @marko/desktop",
    "build": "npm run build -w @marko/desktop",
    "build:lib": "vite build --config vite.library.config.ts && vue-tsc -p tsconfig.library.json && node scripts/build-library-types.mjs",
    "prepare": "npm run build:lib",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck --workspaces --if-present && depcruise packages apps --config .dependency-cruiser.cjs",
    "test:e2e": "npm run build -w @marko/desktop && playwright test -c test/e2e/playwright.config.ts",
    "test:e2e:packaged": "node scripts/e2e-packaged.mjs",
    "test:interaction": "npm run test:interaction -w @marko/editor",
    "test:visual": "npm run build -w @marko/desktop && node test/visual/build-html.mjs && playwright test -c test/visual/playwright.config.ts",
    "pack": "npm run pack -w @marko/desktop",
    "dist": "npm run dist -w @marko/desktop",
    "verify": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "1.8.1",
    "@mathjax/mathjax-newcm-font": "4.0.0",
    "@mathjax/src": "4.0.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "dompurify": "^3.4.5",
    "element-plus": "^2.14.8",
    "emojibase-data": "^18.0.0",
    "entities": "^9.0.0",
    "prosemirror-search": "^1.1.1",
    "vue": "^3.5.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^18.9.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
